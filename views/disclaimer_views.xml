<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Invoice Disclaimer Tree View -->
        <record id="view_invoice_disclaimer_tree" model="ir.ui.view">
            <field name="name">invoice.disclaimer.tree</field>
            <field name="model">invoice.disclaimer</field>
            <field name="arch" type="xml">
                <tree string="Invoice Disclaimers">
                    <field name="name"/>
                    <field name="content" widget="html"/>
                    <field name="active"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </tree>
            </field>
        </record>

        <!-- Invoice Disclaimer Form View -->
        <record id="view_invoice_disclaimer_form" model="ir.ui.view">
            <field name="name">invoice.disclaimer.form</field>
            <field name="model">invoice.disclaimer</field>
            <field name="arch" type="xml">
                <form string="Invoice Disclaimer">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                                <field name="active" widget="boolean_button" options="{'terminology': 'archive'}"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name" placeholder="e.g., Standard Disclaimer"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <group string="Disclaimer Content">
                            <field name="content" widget="html" placeholder="Enter the disclaimer text that will appear in the footer of invoices..."/>
                        </group>
                        <group string="Customers Using This Disclaimer">
                            <field name="partner_ids" widget="many2many_tags"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Invoice Disclaimer Search View -->
        <record id="view_invoice_disclaimer_search" model="ir.ui.view">
            <field name="name">invoice.disclaimer.search</field>
            <field name="model">invoice.disclaimer</field>
            <field name="arch" type="xml">
                <search string="Search Invoice Disclaimers">
                    <field name="name" string="Disclaimer Name"/>
                    <field name="content" string="Content"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Company" name="company" domain="[]" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                        <filter string="Active Status" name="active_status" domain="[]" context="{'group_by': 'active'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Invoice Disclaimer Action -->
        <record id="action_invoice_disclaimer" model="ir.actions.act_window">
            <field name="name">Invoice Disclaimers</field>
            <field name="res_model">invoice.disclaimer</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first invoice disclaimer!
                </p>
                <p>
                    Invoice disclaimers allow you to add specific legal or informational text to customer invoices.
                    You can assign different disclaimers to different customers based on their requirements.
                </p>
            </field>
        </record>

        <!-- Menu Items -->
        <menuitem id="menu_invoice_disclaimer_root"
                  name="Invoice Disclaimers"
                  parent="account.menu_finance_configuration"
                  sequence="50"/>

        <menuitem id="menu_invoice_disclaimer"
                  name="Invoice Disclaimers"
                  parent="menu_invoice_disclaimer_root"
                  action="action_invoice_disclaimer"
                  sequence="10"/>
    </data>
</odoo>
