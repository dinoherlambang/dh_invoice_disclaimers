<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit Invoice Form to Show Disclaimer -->
        <record id="view_move_form_disclaimer" model="ir.ui.view">
            <field name="name">account.move.form.disclaimer</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <field name="ref" position="after">
                    <field name="invoice_disclaimer" readonly="1" 
                           attrs="{'invisible': [('invoice_disclaimer', '=', False)]}"
                           widget="html"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
